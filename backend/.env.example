PORT=3001
REDIS_URL=redis://127.0.0.1:6379
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001

# Optional transactional email delivery through Resend.
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# Optional Telegram delivery. Put the per-monitor chat ID in the dashboard.
TELEGRAM_BOT_TOKEN=

# Optional one-line AI change summaries. When this is not set, Changewatch
# uses its built-in factual summary instead.
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-5-mini
